name: Build VST3

on:
  push:
  workflow_dispatch:

jobs:
  build-windows:
    runs-on: windows-2022
    steps:
      - name: Get the code
        uses: actions/checkout@v4

      - name: Configure
        run: cmake -B build -A x64

      - name: Build (Release)
        run: cmake --build build --config Release --parallel

      - name: Upload the finished plugin
        uses: actions/upload-artifact@v4
        with:
          name: VocalSuite-VST3
          path: build/VocalSuite_artefacts/Release/VST3/
          if-no-files-found: error
